{
  "name": "commonmind",
  "version": "0.1.2",
  "description": "CockroachDB-as-memory for the agentic workforce. Capture · recall · act — reliably, globally, at any scale.",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://commonmind.agent9.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LandCruiserWorld/commonmind.git"
  },
  "bugs": {
    "url": "https://github.com/LandCruiserWorld/commonmind/issues"
  },
  "keywords": [
    "agent-memory",
    "ai-agents",
    "cockroachdb",
    "vector-search",
    "semantic-search",
    "mcp",
    "aws",
    "bedrock"
  ],
  "bin": {
    "commonmind": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "provision-pipeline": "node scripts/provision-pipeline.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1103.0",
    "@aws-sdk/client-sns": "^3.1105.0",
    "@aws-sdk/client-sqs": "^3.1105.0",
    "dotenv": "^17.4.2",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.6.0"
  }
}
