# CommonMind memory — environment (copy to .env and fill)
# NEVER commit the real .env.

# Your local (or CockroachDB Cloud) connection string
#   Local single-node dev mode:  postgresql://root@127.0.0.1:26257/commonmind?sslmode=disable
COCKROACH_DB_URL=postgresql://root@127.0.0.1:26257/commonmind?sslmode=disable

# Auth token for the webhook/memory API. Generate:  openssl rand -hex 24
COMMONMIND_API_TOKEN=change-me

# Embedding provider: 'local' uses a bundled model, 'bedrock' uses Amazon Bedrock.
EMBED_PROVIDER=local

# Amazon Bedrock (only needed if EMBED_PROVIDER=bedrock)
AWS_REGION=us-east-1
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# SNS topic ARN for the CDC -> push pipeline (optional)
COMMONMIND_SNS_TOPIC_ARN=